# solbot2 — variables d'environnement
# NE COMMITTEZ JAMAIS CE FICHIER (.env est dans .gitignore) — chmod 600 appliqué par `npm run setup`

# Clé privée du wallet de trading (générée par `npm run setup`, format base58 64 octets)
BS58_PRIVATE_KEY=

# Clé API Jupiter (optionnelle — https://developers.jup.ag/portal)
# Sans clé : limite 0.5 req/s (keyless). Avec clé : 1 req/s (Free), mêmes endpoints.
JUPITER_API_KEY=
# Débit max req/s (défaut : 0.5 sans clé, 1 avec clé)
JUPITER_RPS=

# RPC Solana (lecture soldes/réconciliation). Le RPC public est lent/thrôtté —
# Helius/QuickNode recommandés en production.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Token optionnel pour protéger le dashboard (lu sur toutes les routes s'il est défini)
DASHBOARD_TOKEN=

# Mode courant (surcharge : config.yaml < MODE < --paper/--dry-run/--live)
# paper | dry_run | live
MODE=

LOG_LEVEL=info
